# ---------------------------------------------------------------------------
# Flightscape environment configuration
#
# Every variable here is OPTIONAL. Flightscape runs with live flight data and a
# 3D globe out of the box using keyless providers. Keys unlock higher quality
# terrain/imagery and additional data sources.
#
# Copy to `.env.local` and fill in what you have:   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- 3D Earth ---------------------------------------------------------------
# Cesium Ion token. Free tier: https://ion.cesium.com/tokens
# Without it, Flightscape falls back to OpenStreetMap imagery + ellipsoid
# terrain, which works but has no 3D terrain relief.
# This is public by design (it is used by the browser and is scoped/revocable).
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- Flight data providers --------------------------------------------------
# Which provider the server uses for live positions.
#   adsb    - adsb.lol + adsbdb. Keyless, community ADS-B. (default)
#   opensky - OpenSky Network. Keyless anonymously; OAuth2 raises limits.
FLIGHT_PROVIDER=adsb

# OpenSky Network OAuth2 client credentials (optional).
# Anonymous access = 400 credits/day. An account raises this substantially.
# Create at https://opensky-network.org/ -> Account -> API Client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Polling ----------------------------------------------------------------
# Seconds between live position polls. Keep this respectful of the provider.
FLIGHT_POLL_INTERVAL_SECONDS=8
